{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker/**/*.ts", "worker/**/*.d.ts", "vite.config.ts"]
}
