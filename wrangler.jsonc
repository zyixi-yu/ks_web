{
  // 静态资源 + Worker：部署命令 `npx wrangler deploy`
  "name": "ks",
  "compatibility_date": "2026-01-24",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"]
  },
  "ratelimits": [{ "name": "ADMIN_LOGIN_LIMIT", "namespace_id": "5220261022", "simple": { "limit": 8, "period": 60 } }],
  "kv_namespaces": [
    {
      "binding": "KS_KV",
      "id": "d3c562ecc2f04c1eb4f920ae9bda71a2"
    }
  ],
  "env": {
    "preview": {
      "name": "ks-web-preview",
      "kv_namespaces": [
        {
          "binding": "KS_KV",
          "id": "d3c562ecc2f04c1eb4f920ae9bda71a2"
        }
      ]
    }
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
